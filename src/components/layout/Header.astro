---
const { user } = Astro.locals;
const { pathname } = Astro.url;

const isDashboardActive = pathname === "/dashboard";
const isTasksActive = pathname.startsWith("/tasks");
---

<header class="flex items-center justify-between gap-4 px-4 py-3 text-sm text-white/80 sm:px-8">
  <div class="flex items-center gap-6">
    <a href="/" class="font-semibold text-white transition-colors hover:text-white/80">10x Home Maintenance</a>
    {
      user && (
        <nav class="flex items-center gap-4">
          <a
            href="/dashboard"
            aria-current={isDashboardActive ? "page" : undefined}
            class:list={[
              "transition-colors hover:text-white",
              isDashboardActive ? "font-semibold text-white" : "text-purple-300 hover:text-purple-100",
            ]}
          >
            Dashboard
          </a>
          <a
            href="/tasks"
            aria-current={isTasksActive ? "page" : undefined}
            class:list={[
              "transition-colors hover:text-white",
              isTasksActive ? "font-semibold text-white" : "text-purple-300 hover:text-purple-100",
            ]}
          >
            Tasks
          </a>
        </nav>
      )
    }
  </div>
  {
    user ? (
      <div class="flex items-center gap-4">
        <a href="/account/delete" class="text-blue-100/70 transition-colors hover:text-white hover:underline">
          {user.email}
        </a>
        <form method="POST" action="/api/auth/signout">
          <button type="submit" class="text-purple-300 transition-colors hover:text-purple-100 hover:underline">
            Sign out
          </button>
        </form>
      </div>
    ) : (
      <div class="flex items-center gap-4">
        <span class="text-blue-100/70">Not signed in</span>
        <div class="flex gap-3">
          <a href="/auth/signin" class="text-purple-300 transition-colors hover:text-purple-100 hover:underline">
            Sign in
          </a>
          <a href="/auth/signup" class="text-purple-300 transition-colors hover:text-purple-100 hover:underline">
            Sign up
          </a>
        </div>
      </div>
    )
  }
</header>
