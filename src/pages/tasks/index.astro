---
import { parseISO } from "date-fns";
import Layout from "@/layouts/Layout.astro";
import TaskList from "@/components/tasks/TaskList";
import { createClient } from "@/lib/supabase";
import { compareByUrgency, computeDueDate, computeStatus } from "@/lib/status";
import type { MaintenanceTaskWithStatus } from "@/types";

const success = Astro.url.searchParams.get("success");
const error = Astro.url.searchParams.get("error");
const editing = Astro.url.searchParams.get("editing");
const next = Astro.url.searchParams.get("next");
const unit = Astro.url.searchParams.get("unit");

const supabase = createClient(Astro.request.headers, Astro.cookies);

let tasks: MaintenanceTaskWithStatus[] = [];
if (supabase) {
  const { data } = await supabase.from("maintenance_tasks").select("*");
  const today = new Date();
  tasks = (data ?? [])
    .map((task) => {
      const dueDate = computeDueDate(parseISO(task.last_done_date), task.frequency_value, task.frequency_unit);
      return { ...task, dueDate, status: computeStatus(dueDate, today) };
    })
    .sort(compareByUrgency);
}
---

<Layout title="Manage tasks">
  <div class="min-h-screen p-4">
    <div class="mx-auto max-w-4xl">
      <div class="mb-6">
        <h1 class="bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-3xl font-bold text-transparent">
          Manage tasks
        </h1>
      </div>
      <TaskList tasks={tasks} success={success} error={error} editing={editing} next={next} unit={unit} client:load />
    </div>
  </div>
</Layout>
