---
import { parseISO } from "date-fns";
import Layout from "@/layouts/Layout.astro";
import AddTaskDialog from "@/components/tasks/AddTaskDialog";
import { createClient } from "@/lib/supabase";
import { compareByUrgency, computeDueDate, computeStatus } from "@/lib/status";
import type { MaintenanceTaskWithStatus } from "@/types";

const { user } = Astro.locals;
const error = Astro.url.searchParams.get("error");

const supabase = createClient(Astro.request.headers, Astro.cookies);
const { data: rawTasks, error: tasksError } = supabase
  ? await supabase.from("maintenance_tasks").select("*")
  : { data: null, error: null };

if (tasksError) {
  // eslint-disable-next-line no-console -- log the real error server-side; the banner below shows the user a generic message instead of the raw DB error.
  console.error("Failed to load maintenance tasks:", tasksError);
}

const today = new Date();
const tasks: MaintenanceTaskWithStatus[] = (rawTasks ?? [])
  .map((task) => {
    const dueDate = computeDueDate(parseISO(task.last_done_date), task.frequency_value, task.frequency_unit);
    return { ...task, dueDate, status: computeStatus(dueDate, today) };
  })
  .sort(compareByUrgency);

const STATUS_LABEL: Record<MaintenanceTaskWithStatus["status"], string> = {
  OVERDUE: "Overdue",
  DUE_SOON: "Due soon",
  OK: "OK",
};
---

<Layout title="Dashboard">
  <div class="bg-cosmic min-h-screen p-4">
    <div class="mx-auto max-w-2xl">
      <div class="mb-6 flex items-center justify-between gap-4">
        <div>
          <h1 class="bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-3xl font-bold text-transparent">
            Dashboard
          </h1>
          <p class="text-blue-100/80">
            Welcome, <span class="font-semibold text-white">{user?.email}</span>
          </p>
          <p class="mt-1">
            <a href="/tasks" class="text-sm text-blue-100/80 underline hover:text-white">Manage tasks</a>
          </p>
        </div>
        <AddTaskDialog client:load serverError={error} />
      </div>

      {
        tasksError ? (
          <p class="border-destructive/30 bg-destructive/10 text-destructive rounded-2xl border p-6 text-center">
            We're having trouble loading your tasks right now. Please try refreshing the page.
          </p>
        ) : tasks.length === 0 ? (
          <p class="rounded-2xl border border-white/10 bg-white/10 p-6 text-center text-blue-100/80">
            No maintenance tasks yet.
          </p>
        ) : (
          <ul class="space-y-3">
            {tasks.map((task) => (
              <li class="rounded-xl border border-white/10 bg-white/10 p-4 text-white">
                <div class="flex items-center justify-between">
                  <span class="font-semibold">{task.name}</span>
                  <span class="text-xs text-blue-100/60 uppercase">{STATUS_LABEL[task.status]}</span>
                </div>
                <p class="mt-1 text-sm text-blue-100/70">
                  {task.category} · {task.importance} · due {task.dueDate.toDateString()}
                </p>
              </li>
            ))}
          </ul>
        )
      }

      <form method="POST" action="/api/auth/signout" class="mt-6">
        <button
          type="submit"
          class="rounded-lg border border-white/20 bg-white/10 px-4 py-2 text-sm text-white transition-colors hover:bg-white/20"
        >
          Sign out
        </button>
      </form>
    </div>
  </div>
</Layout>

<script>
  import { toast } from "sonner";

  const params = new URLSearchParams(location.search);
  if (params.get("success") === "task-added") {
    toast.success("Task added");
    history.replaceState(null, "", location.pathname);
  }
</script>
