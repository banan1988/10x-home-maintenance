{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "npx eslint --fix . --quiet 1>&2",
            "timeout": 30000
          },
          {
            "type": "command",
            "command": "npx tsc --noEmit 1>&2",
            "timeout": 30000
          }
        ]
      }
    ]
  }
}
